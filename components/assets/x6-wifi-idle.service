[Unit]
Description=X6 hotspot idle timeout
After=data.mount x6-firstboot-settings.service
Requires=data.mount

[Service]
Type=simple
User=root
Group=root
UMask=0077
RuntimeDirectory=x6-wifi-idle
RuntimeDirectoryMode=0755
SELinuxContext=system_u:system_r:unconfined_t:s0-s15:c0.c1023
ExecStart=/usr/bin/python3 -B /usr/local/sbin/x6-wifi-idle.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
