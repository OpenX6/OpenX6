[Unit]
Description=OpenX6 x6-stats-control
Requires=x6-runtime-prepare.service
After=x6-runtime-prepare.service ins_gui.service ins_mediad.service
[Service]
Type=simple
Environment=X6_STATS_PERSIST=1
ExecStart=/usr/local/sbin/x6-statsd
Restart=on-failure
RestartSec=5
TimeoutStopSec=12
StandardOutput=null
StandardError=null
